# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/openall.db

# Model Configuration
MODEL_CACHE_DIR=./models
DEFAULT_MODEL=qwen2.5-7b
AUTO_DOWNLOAD_MODEL=true

# API Keys (Optional - for cloud model access)
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
DEEPSEEK_API_KEY=

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Plugin System
PLUGIN_ENABLED=true
PLUGIN_MARKET_URL=https://plugins.openall.ai

# Media Processing
MEDIA_TEMP_DIR=./data/temp
MAX_FILE_SIZE=100MB
